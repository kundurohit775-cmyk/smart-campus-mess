<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Smart Campus Mess Management System</display-name>
    <description>Core Java &amp; Servlets Module for SmartMess</description>

    <!-- Menu Items Servlet -->
    <servlet>
        <servlet-name>MenuServlet</servlet-name>
        <servlet-class>com.smartmess.servlet.MenuServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MenuServlet</servlet-name>
        <url-pattern>/api/java/menu</url-pattern>
    </servlet-mapping>

    <!-- Order Placement Servlet -->
    <servlet>
        <servlet-name>OrderServlet</servlet-name>
        <servlet-class>com.smartmess.servlet.OrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderServlet</servlet-name>
        <url-pattern>/api/java/order</url-pattern>
    </servlet-mapping>

    <!-- Order History & CSV Export Servlet -->
    <servlet>
        <servlet-name>OrderHistoryServlet</servlet-name>
        <servlet-class>com.smartmess.servlet.OrderHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderHistoryServlet</servlet-name>
        <url-pattern>/api/java/history</url-pattern>
    </servlet-mapping>

    <!-- Kitchen Queue Servlet -->
    <servlet>
        <servlet-name>KitchenQueueServlet</servlet-name>
        <servlet-class>com.smartmess.servlet.KitchenQueueServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>KitchenQueueServlet</servlet-name>
        <url-pattern>/api/java/kitchen</url-pattern>
    </servlet-mapping>

</web-app>
