# Smart Campus Mess Management System Environment Configuration
PORT=5050

# Better Auth Secret (Generate a 64-character random secret)
BETTER_AUTH_SECRET=your_better_auth_secret_64_characters_here
BETTER_AUTH_URL=http://localhost:5050

# Neon PostgreSQL Database Connection URL
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Authorized Dedicated Chef Email (Backend-only restriction)
CHEF_EMAIL=chef@example.com

# Authorized Dedicated Admin Email (Backend-only restriction)
ADMIN_EMAIL=admin@example.com

# ==============================================================================
# SMS Provider Configuration for Mobile OTP (Twilio Verify & Messaging)
# ==============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# ==============================================================================
# MSG91 Configuration (Optional Alternative)
# ==============================================================================
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ==============================================================================
# Razorpay Payment Gateway Configuration (1 Rupee = 1 Credit)
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ==============================================================================
# Resend Email Configuration for Email OTP Verification
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Smart Campus Mess <onboarding@resend.dev>
OTP_EXPIRY_MINUTES=10
